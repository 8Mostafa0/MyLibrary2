<UserControl x:Class="MyLibrary.View.Views.BookApiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyLibrary.View.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Text="کتاب های جدید"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="6" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Text=": عنوان"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Text="{Binding Name}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding ID}"/>

        <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="6" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Text=": نویسنده"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Author}"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Text=": خلاصه"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Grid.RowSpan="2" Padding="20" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Description}"/>
        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Content="قبلی" Command="{Binding PreviousBookCommand}"/>
        <Button Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2" Margin="10" Content="بعدی" Command="{Binding NextBookCommand}"/>
    </Grid>
</UserControl>
