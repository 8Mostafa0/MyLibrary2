<Window x:Class="MyLibrary.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyLibrary.View"
        xmlns:lv="clr-namespace:MyLibrary.View.Layouts"
        xmlns:vv="clr-namespace:MyLibrary.View.Views"
        xmlns:lvms="clr-namespace:MyLibrary.ViewModel.ViewModels;assembly=MyLibrary.ViewModel" 
        xmlns:md="clr-namespace:ModalControl;assembly=ModalControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <md:Modal>
            <ContentControl Content="{Binding ModalContent}"/>
        </md:Modal>
    </Grid>
</Window>
